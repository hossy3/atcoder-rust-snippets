  "build_primes": {
    "prefix": "_build_primes",
    "description": "素数列挙",
    "body": [
      "fn build_primes(n: usize) -> Vec<usize> {",
      "\tlet mut primes = vec![true; n + 1];",
      "\tprimes[0] = false;",
      "\tprimes[1] = false;",
      "\tfor i in 2..=n {",
      "\t\tif !primes[i] {",
      "\t\t\tcontinue;",
      "\t\t}",
      "\t\tlet m = n / i;",
      "\t\tfor j in 2..=m {",
      "\t\t\tprimes[i * j] = false;",
      "\t\t}",
      "\t}",
      "",
      "\tlet m = primes.iter().filter(|&&b| b).count();",
      "\tlet mut result = Vec::with_capacity(m);",
      "\tfor (i, &b) in primes.iter().enumerate() {",
      "\t\tif b {",
      "\t\t\tresult.push(i);",
      "\t\t}",
      "\t}",
      "\tresult",
      "}",
      ""
    ]
  },
  "prime_division": {
    "prefix": "_prime_division",
    "description": "素因数分解 (Prime division)",
    "body": [
      "fn prime_division(mut n: usize) -> Vec<(usize, usize)> {",
      "\tlet mut result = vec![];",
      "\tlet mut k = 2;",
      "\twhile k * k <= n {",
      "\t\tlet mut count = 0;",
      "\t\twhile n % k == 0 {",
      "\t\t\tcount += 1;",
      "\t\t\tn /= k;",
      "\t\t}",
      "\t\tif count > 0 {",
      "\t\t\tresult.push((k, count));",
      "\t\t}",
      "\t\tk += if k == 2 { 1 } else { 2 };",
      "\t}",
      "\tif n > 1 {",
      "\t\tresult.push((n, 1));",
      "\t}",
      "\tresult",
      "}",
      ""
    ]
  },
  "mat_pow": {
    "prefix": "_mat_pow",
    "description": "行列累乗",
    "body": [
      "/// 行列累乗",
      "fn mat_pow(mat: &[Vec<Mint>], k: usize) -> Vec<Vec<Mint>> {",
      "\tfn mat_mul(mat0: &[Vec<Mint>], mat1: &[Vec<Mint>]) -> Vec<Vec<Mint>> {",
      "\t\tassert_eq!(mat0[0].len(), mat1.len());",
      "\t\tlet mut mat = vec![vec![Mint::new(0); mat1[0].len()]; mat0.len()];",
      "\t\tfor i in 0..mat0.len() {",
      "\t\t\tfor j in 0..mat1[0].len() {",
      "\t\t\t\tfor k in 0..mat0[0].len() {",
      "\t\t\t\t\tmat[i][j] += mat0[i][k] * mat1[k][j];",
      "\t\t\t\t}",
      "\t\t\t}",
      "\t\t}",
      "\t\tmat",
      "\t}",
      "",
      "\tlet mut mul: Vec<_> = mat.iter().cloned().collect();",
      "\tlet mut result = vec![vec![Mint::new(0); mat[0].len()]; mat.len()];",
      "\tfor i in 0..mul.len() {",
      "\t\tresult[i][i] = Mint::new(1);",
      "\t}",
      "\tlet mut k = k;",
      "\twhile k != 0 {",
      "\t\tif k & 1 != 0 {",
      "\t\t\tresult = mat_mul(&result, &mul);",
      "\t\t}",
      "\t\tmul = mat_mul(&mul, &mul);",
      "\t\tk >>= 1;",
      "\t}",
      "\tresult",
      "}"
    ]
  },
