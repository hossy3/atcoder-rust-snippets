  "bit_subset": {
    "prefix": "_bit_subset",
    "description": "ビット集合の部分集合を列挙するイテレータを返す",
    "body": [
      "struct BitSubset {",
      "\tstart: usize,",
      "\tnext: Option<usize>,",
      "}",
      "",
      "impl Iterator for BitSubset {",
      "\ttype Item = usize;",
      "",
      "\tfn next(&mut self) -> Option<Self::Item> {",
      "\t\tlet cur = self.next;",
      "\t\tif let Some(x) = self.next {",
      "\t\t\tself.next = if x > 0 {",
      "\t\t\t\tSome((x - 1) & self.start)",
      "\t\t\t} else {",
      "\t\t\t\tNone",
      "\t\t\t};",
      "\t\t}",
      "\t\tcur",
      "\t}",
      "}",
      "",
      "/// ビット集合の部分集合を列挙するイテレータを返す",
      "fn bit_subset(start: usize) -> BitSubset {",
      "\tBitSubset {",
      "\t\tstart,",
      "\t\tnext: Some(start),",
      "\t}",
      "}"
    ]
  },
  "two_pointer": {
    "prefix": "_two_pointer",
    "description": "尺取り法 (Two pointer technique)",
    "body": [
      "/// 尺取り法 (Two pointer technique) で条件を満たす区間の最大長さを求める例",
      "fn two_pointer(k: isize, a: &[isize]) -> usize {",
      "\tlet n = a.len();",
      "",
      "\tlet mut result = 0;",
      "\tlet mut r = 0;",
      "\tlet mut set: BTreeSet<(isize, usize)> = BTreeSet::new();",
      "\tfor l in 0..n {",
      "\t\twhile r < a.len()",
      "\t\t\t&& (set.len() == 0",
      "\t\t\t\t|| set.last().unwrap().0.max(a[r]) - set.first().unwrap().0.min(a[r]) <= k)",
      "\t\t{",
      "\t\t\tset.insert((a[r], r));",
      "\t\t\tr += 1;",
      "\t\t\tresult = result.max(set.len());",
      "\t\t}",
      "\t\tset.remove(&(a[l], l));",
      "\t}",
      "\tresult",
      "}"
    ]
  },
  "has_intersect": {
    "prefix": "_has_intersect",
    "description": "干渉があるか (接触は含まない)",
    "body": [
      "fn has_intersect((x0, x1): (usize, usize), (x2, x3): (usize, usize)) -> bool {",
      "\tx0.max(x2) < x1.min(x3)",
      "}"
    ]
  },
  // データ構造
  "lazysegtree_maxadd": {
    "prefix": "_lazysegtree_maxadd",
    "description": "遅延セグメント木 区間加算 区間最大値",
    "body": [
      "/// 遅延セグメント木 区間加算 区間最大値",
      "/// # Examples",
      "/// ```",
      "/// let mut segtree: LazySegtree<MaxAdd> = vec![0usize; w].into();",
      "/// ```",
      "struct MaxAdd;",
      "impl MapMonoid for MaxAdd {",
      "\ttype M = Max<usize>;",
      "\ttype F = usize;",
      "",
      "\tfn identity_map() -> Self::F {",
      "\t\t0",
      "\t}",
      "\tfn mapping(&f: &Self::F, &x: &<Self::M as Monoid>::S) -> <Self::M as Monoid>::S {",
      "\t\tf + x",
      "\t}",
      "\tfn composition(&f: &Self::F, &g: &Self::F) -> Self::F {",
      "\t\tf + g",
      "\t}",
      "}"
    ]
  },
  "lazysegtree_addadd": {
    "prefix": "_lazysegtree_addadd",
    "description": "遅延セグメント木 区間加算 区間和",
    "body": [
      "/// 遅延セグメント木 区間加算 区間和 (区間の大きさも保持する)",
      "/// # Examples",
      "/// ```",
      "/// let mut segtree: LazySegtree<AddAdd> = (0..10).map(|&x| (1, x)).collect::<Vec<_>>().into();",
      "/// ```",
      "pub struct AddAddM;",
      "impl Monoid for AddAddM {",
      "\ttype S = (usize, usize); // (区間, 値)",
      "\tfn identity() -> Self::S {",
      "\t\t(1, 0)",
      "\t}",
      "\tfn binary_operation(a: &Self::S, b: &Self::S) -> Self::S {",
      "\t\t(a.0 + b.0, a.1 + b.1)",
      "\t}",
      "}",
      "",
      "struct AddAdd;",
      "impl MapMonoid for AddAdd {",
      "\ttype M = AddAddM;",
      "\ttype F = usize;",
      "",
      "\tfn identity_map() -> Self::F {",
      "\t\t0",
      "\t}",
      "\tfn mapping(&f: &Self::F, &x: &<Self::M as Monoid>::S) -> <Self::M as Monoid>::S {",
      "\t\t(x.0, x.1 + f * x.0)",
      "\t}",
      "\tfn composition(&f: &Self::F, &g: &Self::F) -> Self::F {",
      "\t\tf + g",
      "\t}",
      "}"
    ]
  },
  "ordered_disjoint_tree": {
    "prefix": "_ordered_disjoint_tree",
    "description": "Ordered Disjoint Tree (ODT) 「値が同じ連続区間」を set で管理する",
    "body": [
      "/// Ordered Disjoint Tree (ODT) を初期設定する",
      "fn ordered_disjoint_tree_init(c: &[usize]) -> (BTreeSet<(usize, usize)>, FenwickTree<isize>) {",
      "\tlet n = c.len();",
      "\tlet mut set: BTreeSet<(usize, usize)> = BTreeSet::new();",
      "\tlet mut fenwick = FenwickTree::new(n + 1, 0isize);",
      "\tfor (i, &c) in c.iter().enumerate() {",
      "\t\tif i == 0 || c != set.last().unwrap().1 {",
      "\t\t\tset.insert((i, c));",
      "\t\t\tfenwick.add(i, 1);",
      "\t\t}",
      "\t}",
      "\t(set, fenwick)",
      "}",
      "",
      "/// [l, r) の範囲を x に置き換える",
      "fn ordered_disjoint_tree_assign(",
      "\tset: &mut BTreeSet<(usize, usize)>,",
      "\tfenwick: &mut FenwickTree<isize>,",
      "\tl: usize,",
      "\tr: usize,",
      "\tx: usize,",
      ") {",
      "\tlet (_, xl) = *set.range((0, 0)..(l, 0)).last().unwrap_or(&(0, usize::MAX));",
      "\tlet (_, xr) = *set.range((0, 0)..(r + 1, 0)).last().unwrap();",
      "",
      "\twhile let Some(&(i, c)) = set.range((l, 0)..(r + 1, 0)).last() {",
      "\t\tset.remove(&(i, c));",
      "\t\tfenwick.add(i, -1);",
      "\t}",
      "",
      "\tif xl != x {",
      "\t\tset.insert((l, x));",
      "\t\tfenwick.add(l, 1);",
      "\t}",
      "\tif xr != x {",
      "\t\tset.insert((r, xr));",
      "\t\tfenwick.add(r, 1);",
      "\t}",
      "}",
      "",
      "/// [l, r) の同じ値が連続する区間数を返す",
      "fn ordered_disjoint_tree_count(fenwick: &FenwickTree<isize>, l: usize, r: usize) -> isize {",
      "\tif l + 1 <= r {",
      "\t\tfenwick.sum((l + 1)..r) + 1",
      "\t} else {",
      "\t\t0",
      "\t}",
      "}"
    ]
  },
  "hilbert_order": {
    "prefix": "_hilbert_order",
    "description": "ヒルベルト曲線 (Hilbert curve) の順に 2次元座標を変換して返す",
    "body": [
      "fn hilbert_order(mut x: usize, mut y: usize) -> usize {",
      "\tconst MAX: usize = 1 << 31;",
      "",
      "\tlet mut d = 0;",
      "\tlet mut s = MAX >> 1;",
      "\twhile s > 0 {",
      "\t\tlet rx = (x & s) > 0;",
      "\t\tlet ry = (y & s) > 0;",
      "\t\tlet r = (if rx { 3 } else { 0 }) ^ (if ry { 1 } else { 0 });",
      "\t\td += s * s * r;",
      "\t\ts = s >> 1;",
      "\t\tif ry {",
      "\t\t\tcontinue;",
      "\t\t}",
      "\t\tif rx {",
      "\t\t\tx = MAX - 1 - x;",
      "\t\t\ty = MAX - 1 - y;",
      "\t\t}",
      "\t\tswap(&mut x, &mut y);",
      "\t}",
      "\td",
      "}"
    ]
  },
  "sliding_window_push_max": {
    "prefix": "_sliding_window_push_max",
    "description": "スライド最小値・スライド最大値 (Sliding Window Aggregation, SWAG)",
    "body": [
      "/// スライド最小値・スライド最大値 (Sliding Window Aggregation, SWAG)",
      "fn sliding_window_push_max(deque: &mut VecDeque<(usize, isize)>, i: usize, value: isize) {",
      "\twhile deque.len() > 0 && deque[deque.len() - 1].1 <= value {",
      "\t\tdeque.pop_back();",
      "\t}",
      "\tdeque.push_back((i, value));",
      "}"
    ]
  },
  "inversion": {
    "prefix": "_inversion",
    "description": "転倒数 (inversion) を求める",
    "body": [
      "/// 転倒数 (inversion) を求める",
      "/// * `a` - 0 開始の配列。 例: `[3, 1, 4, 2, 0]`",
      "fn inversion(a: &[usize]) -> usize {",
      "\tlet n = a.len();",
      "\tlet mut tree = FenwickTree::new(n, 0usize);",
      "\tlet mut count = 0usize;",
      "\tfor (_, &xr) in a.iter().enumerate() {",
      "\t\ttree.add(xr, 1);",
      "\t\tcount += tree.sum((xr + 1)..);",
      "\t}",
      "",
      "\tcount",
      "}"
    ]
  },
  // misc
  "count_grid_by_imos_2d": {
    "prefix": "_count_grid_by_imos_2d",
    "description": "(r1 - r0) * (c1 - c0) の大きさの長方形を重ねた時に、各グリッドに何枚あるかを imos 2D で求める",
    "body": [
      "/// (r1 - r0) * (c1 - c0) の大きさの長方形を重ねた時に、各グリッドに何枚あるかを imos 2D で求める",
      "fn count_grid_by_imos_2d(n: usize, rc: &[(usize, usize, usize, usize)]) -> Vec<Vec<usize>> {",
      "\tlet mut imos = vec![vec![0isize; n + 1]; n + 1];",
      "\tfor &(r0, c0, r1, c1) in rc {",
      "\t\timos[r0][c0] += 1;",
      "\t\timos[r1 + 1][c0] -= 1;",
      "\t\timos[r0][c1 + 1] -= 1;",
      "\t\timos[r1 + 1][c1 + 1] += 1;",
      "\t}",
      "",
      "\tlet mut counts = vec![vec![0isize; n + 1]; n + 1];",
      "\tfor x in 0..n {",
      "\t\tfor y in 0..n {",
      "\t\t\tcounts[x + 1][y + 1] = counts[x][y + 1] + counts[x + 1][y] - counts[x][y] + imos[x][y];",
      "\t\t}",
      "\t}",
      "",
      "\tlet mut results = vec![vec![0; n]; n];",
      "\tfor x in 0..n {",
      "\t\tfor y in 0..n {",
      "\t\t\tresults[x][y] = counts[x + 1][y + 1] as usize;",
      "\t\t}",
      "\t}",
      "\tresults",
      "}"
    ]
  },
  "compress_coordinates": {
    "prefix": "_compress_coordinates",
    "description": "座標圧縮 (Compress coordinates)",
    "body": [
      "/// 座標圧縮 (Compress coordinates)",
      "fn compress_coordinates(a: &[usize]) -> Vec<usize> {",
      "\tlet mut sorted = a.to_vec();",
      "\tsorted.sort_unstable();",
      "\tsorted.dedup();",
      "\tlet mut map = std::collections::HashMap::new();",
      "\tfor (i, &x) in sorted.iter().enumerate() {",
      "\t\tmap.insert(x, i);",
      "\t}",
      "\ta.iter().map(|&x| map[&x]).collect()",
      "}"
    ]
  },
  "meet_in_the_middle": {
    "prefix": "_meet_in_the_middle",
    "description": "半分全列挙 (Meet in the middle)",
    "body": [
      "/// 半分全列挙: a から複数選んで和を s にする組み合わせ数の例",
      "fn meet_in_the_middle(s: usize, a: &[usize]) -> usize {",
      "\tlet n = a.len();",
      "\tassert!(n <= 40);",
      "",
      "\tfn f(a: &[usize]) -> HashMap<usize, usize> {",
      "\t\tlet mut m = HashMap::new();",
      "\t\tm.insert(0usize, 1usize);",
      "\t\tfor &x in a {",
      "\t\t\tlet mut m0 = m.clone();",
      "\t\t\tfor (&k, &v) in &m {",
      "\t\t\t\t*m0.entry(k + x).or_insert(0) += v;",
      "\t\t\t}",
      "\t\t\tm = m0;",
      "\t\t}",
      "\t\tm",
      "\t}",
      "",
      "\tlet m0 = f(&a[..(n / 2)]);",
      "\tlet m1 = f(&a[(n / 2)..]);",
      "",
      "\tlet mut result = 0usize;",
      "\tfor (&k0, &v0) in &m0 {",
      "\t\tif k0 <= s {",
      "\t\t\tif let Some(&v1) = m1.get(&(s - k0)) {",
      "\t\t\t\tresult += v0 * v1;",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "",
      "\tresult",
      "}"
    ]
  }
}
