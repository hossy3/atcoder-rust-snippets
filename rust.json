  "shortest_graph": {
    "prefix": "_shortest_graph",
    "description": "重みなしグラフの s から e までの最短距離を 01-bfs で解く",
    "body": [
      "/// 重みなしグラフの s から e までの最短距離を 01-bfs で解く",
      "fn shortest_graph(graph: &[Vec<usize>], s: usize, e: usize) -> Option<usize> {",
      "\tlet mut set = HashSet::new();",
      "\tlet mut queue = VecDeque::new();",
      "\tqueue.push_back((0, s));",
      "",
      "\twhile let Some((step, i)) = queue.pop_front() {",
      "\t\tif i == e {",
      "\t\t\treturn Some(step);",
      "\t\t}",
      "\t\tfor &j in &graph[i] {",
      "\t\t\tif set.insert(j) {",
      "\t\t\t\tqueue.push_back((step + 1, j));",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\tNone",
      "}"
    ]
  },
  "shortest_graph_weight": {
    "prefix": "_shortest_graph_weight",
    "description": "非負の重み付きグラフの s から e までの最短距離をダイクストラ法で解く",
    "body": [
      "/// 非負の重み付きグラフの s から e までの最短距離をダイクストラ法で解く",
      "fn shortest_graph_weight(graph: &[Vec<(usize, usize)>], s: usize, e: usize) -> Option<usize> {",
      "\tuse std::{cmp::Reverse, collections::BinaryHeap};",
      "",
      "\tlet n = graph.len();",
      "\tlet mut v = vec![None; n];",
      "",
      "\tlet mut heap = BinaryHeap::new();",
      "\theap.push((Reverse(0), s));",
      "\tv[s] = Some(0);",
      "",
      "\twhile let Some((Reverse(step), i)) = heap.pop() {",
      "\t\tif step > v[i].unwrap_or(usize::MAX) {",
      "\t\t\tcontinue;",
      "\t\t}",
      "\t\tif i == e {",
      "\t\t\treturn Some(step);",
      "\t\t}",
      "",
      "\t\tfor &(j, w) in &graph[i] {",
      "\t\t\tlet step = step + w;",
      "\t\t\tlet step0 = v[j].unwrap_or(usize::MAX);",
      "\t\t\tif step < step0 {",
      "\t\t\t\tv[j] = Some(step);",
      "\t\t\t\theap.push((Reverse(step), j));",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "",
      "\tNone",
      "}"
    ]
  },
